{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .dealer-registration-fieldset {
    border: none;
    padding: 0;
    margin: 0 0 3rem 0;
  }

  .dealer-registration-fieldset legend {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    padding: 0;
  }

  .dealer-registration-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .dealer-registration-grid--2col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .dealer-registration-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .dealer-registration-checkbox input {
    margin-top: 0.4rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="title title-wrapper--no-top-margin inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ 'templates.dealer_registration.heading' | t }}
    </h1>
    <p>{{ 'templates.dealer_registration.intro' | t }}</p>

    {%- if request.query_string contains 'error=missing_fields' -%}
      <div class="form__message">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
          {{- 'icon-error.svg' | inline_asset_content -}}
          {{ 'templates.dealer_registration.error_missing_fields' | t }}
        </h2>
      </div>
    {%- elsif request.query_string contains 'error=create_failed' -%}
      <div class="form__message">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
          {{- 'icon-error.svg' | inline_asset_content -}}
          {{ 'templates.dealer_registration.error_create_failed' | t }}
        </h2>
      </div>
    {%- elsif request.query_string contains 'error=not_ready' -%}
      <div class="form__message">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
          {{- 'icon-error.svg' | inline_asset_content -}}
          {{ 'templates.dealer_registration.error_not_ready' | t }}
        </h2>
      </div>
    {%- endif -%}

    <form method="post" action="/apps/dealer/register" id="DealerRegistrationForm" class="isolate">
      <fieldset class="dealer-registration-fieldset">
        <legend>{{ 'templates.dealer_registration.section_company' | t }}</legend>
        <div class="dealer-registration-grid dealer-registration-grid--2col">
          <div class="field">
            <input class="field__input" type="text" id="company_name" name="company_name" required placeholder="{{ 'templates.dealer_registration.company_name' | t }}">
            <label class="field__label" for="company_name">{{ 'templates.dealer_registration.company_name' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="legal_form" name="legal_form" placeholder="{{ 'templates.dealer_registration.legal_form' | t }}">
            <label class="field__label" for="legal_form">{{ 'templates.dealer_registration.legal_form' | t }}</label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="street" name="street" required placeholder="{{ 'templates.dealer_registration.street' | t }}">
            <label class="field__label" for="street">{{ 'templates.dealer_registration.street' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="postal_code" name="postal_code" required placeholder="{{ 'templates.dealer_registration.postal_code' | t }}">
            <label class="field__label" for="postal_code">{{ 'templates.dealer_registration.postal_code' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="city" name="city" required placeholder="{{ 'templates.dealer_registration.city' | t }}">
            <label class="field__label" for="city">{{ 'templates.dealer_registration.city' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <select class="field__input" id="country" name="country" required>
              <option value="DE">Deutschland</option>
              <option value="AT">Österreich</option>
              <option value="CH">Schweiz</option>
            </select>
            <label class="field__label" for="country">{{ 'templates.dealer_registration.country' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="url" id="company_website" name="company_website" placeholder="https://">
            <label class="field__label" for="company_website">{{ 'templates.dealer_registration.company_website' | t }}</label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="vat_id" name="vat_id" required placeholder="{{ 'templates.dealer_registration.vat_id' | t }}">
            <label class="field__label" for="vat_id">{{ 'templates.dealer_registration.vat_id' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="trade_register_no" name="trade_register_no" placeholder="{{ 'templates.dealer_registration.trade_register_no' | t }}">
            <label class="field__label" for="trade_register_no">{{ 'templates.dealer_registration.trade_register_no' | t }}</label>
          </div>
        </div>
      </fieldset>

      <fieldset class="dealer-registration-fieldset">
        <legend>{{ 'templates.dealer_registration.section_contact' | t }}</legend>
        <div class="dealer-registration-grid dealer-registration-grid--2col">
          <div class="field">
            <input class="field__input" type="text" id="contact_first_name" name="contact_first_name" required autocomplete="given-name" placeholder="{{ 'templates.dealer_registration.contact_first_name' | t }}">
            <label class="field__label" for="contact_first_name">{{ 'templates.dealer_registration.contact_first_name' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="contact_last_name" name="contact_last_name" required autocomplete="family-name" placeholder="{{ 'templates.dealer_registration.contact_last_name' | t }}">
            <label class="field__label" for="contact_last_name">{{ 'templates.dealer_registration.contact_last_name' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="text" id="contact_position" name="contact_position" placeholder="{{ 'templates.dealer_registration.contact_position' | t }}">
            <label class="field__label" for="contact_position">{{ 'templates.dealer_registration.contact_position' | t }}</label>
          </div>
          <div class="field">
            <input class="field__input" type="email" id="email" name="email" required autocomplete="email" placeholder="{{ 'templates.dealer_registration.email' | t }}">
            <label class="field__label" for="email">{{ 'templates.dealer_registration.email' | t }}<span aria-hidden="true">*</span></label>
          </div>
          <div class="field">
            <input class="field__input" type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="{{ 'templates.dealer_registration.phone' | t }}">
            <label class="field__label" for="phone">{{ 'templates.dealer_registration.phone' | t }}<span aria-hidden="true">*</span></label>
          </div>
        </div>
      </fieldset>

      <fieldset class="dealer-registration-fieldset">
        <legend>{{ 'templates.dealer_registration.section_business' | t }}</legend>
        <div class="dealer-registration-grid dealer-registration-grid--2col">
          <div class="field">
            <input class="field__input" type="number" min="1" id="branches_count" name="branches_count" placeholder="{{ 'templates.dealer_registration.branches_count' | t }}">
            <label class="field__label" for="branches_count">{{ 'templates.dealer_registration.branches_count' | t }}</label>
          </div>
          <div class="field">
            <select class="field__input" id="sales_mode" name="sales_mode">
              <option value="stationary">{{ 'templates.dealer_registration.sales_mode_stationary' | t }}</option>
              <option value="online">{{ 'templates.dealer_registration.sales_mode_online' | t }}</option>
              <option value="both">{{ 'templates.dealer_registration.sales_mode_both' | t }}</option>
            </select>
            <label class="field__label" for="sales_mode">{{ 'templates.dealer_registration.sales_mode' | t }}</label>
          </div>
        </div>
        <div class="field">
          <textarea rows="5" id="message" name="message" class="text-area field__input" placeholder="{{ 'templates.dealer_registration.message' | t }}"></textarea>
          <label class="form__label field__label" for="message">{{ 'templates.dealer_registration.message' | t }}</label>
        </div>
      </fieldset>

      <div class="dealer-registration-checkbox">
        <input type="checkbox" id="privacy_accepted" name="privacy_accepted" required>
        <label for="privacy_accepted">{{ 'templates.dealer_registration.privacy_accepted' | t }}</label>
      </div>
      <div class="dealer-registration-checkbox">
        <input type="checkbox" id="terms_accepted" name="terms_accepted" required>
        <label for="terms_accepted">{{ 'templates.dealer_registration.terms_accepted' | t }}</label>
      </div>

      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.dealer_registration.submit' | t }}
        </button>
      </div>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Dealer registration form",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Dealer registration form"
    }
  ]
}
{% endschema %}
